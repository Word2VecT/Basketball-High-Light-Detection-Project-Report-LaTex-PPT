# 虚拟环境
.venv/
venv/
env/
ENV/

# Python缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 分发/打包
dist/
build/
*.egg-info/
*.egg

# IDE
.vscode/
.idea/
*.swp
*.swo

# Jupyter Notebook
.ipynb_checkpoints/

# 模型文件（通常很大）
*.pt
*.pth
*.onnx
*.bin
model/
models/

# 视频和图片输出（通常很大）
*.mp4
*.avi
*.gif
*.png
*.jpg
*.jpeg

# output目录下的大文件（保留json配置文件）
output/*/
!output/undist_intrinsics_correct/
!output/重标定外参/
output/undist_intrinsics_correct/*
!output/undist_intrinsics_correct/*.json
output/重标定外参/*
!output/重标定外参/*.json

# K目录（标定相关临时文件）
K/

# 不需要的脚本
visualize_smooth.py

# 日志文件
*.log

# 系统文件
.DS_Store
Thumbs.db

# 临时文件
*.tmp
*.temp
